{
  "name": "@kontourai/plumb",
  "version": "0.2.0",
  "description": "The surveyor's plumb line: checks that things are true — and calls in repairs when they aren't.",
  "license": "Apache-2.0",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kontourai/plumb.git"
  },
  "homepage": "https://github.com/kontourai/plumb#readme",
  "bugs": {
    "url": "https://github.com/kontourai/plumb/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./checks": {
      "types": "./dist/src/checks.d.ts",
      "default": "./dist/src/checks.js"
    }
  },
  "bin": {
    "plumb": "bin/plumb.mjs"
  },
  "files": [
    "dist/src/",
    "bin/",
    "examples/",
    "systemd/",
    "plumb.config.example",
    "README.md",
    "LICENSE",
    "docs/shared-checks.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "verify": "npm run typecheck && npm test && npm pack --dry-run",
    "prepublishOnly": "npm run verify",
    "docs:check": "npx -y github:kontourai/corpus#cc7f6e4939dcc0777c4c3e2d5222b30455013861 corpus check",
    "docs:build": "npx -y github:kontourai/corpus#cc7f6e4939dcc0777c4c3e2d5222b30455013861 corpus build"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0"
}
